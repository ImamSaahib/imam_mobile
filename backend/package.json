{
  "name": "imam-mobile-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply imam-mobile-dev-db --local",
    "db:remote": "wrangler d1 migrations apply imam-mobile-dev-db --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:preview && npm run typecheck && npm test",
    "check:preview": "node scripts/check-preview-config.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.45.0"
  }
}
