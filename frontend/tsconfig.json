{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src/platform",
    "outDir": ".test-build",
    "jsx": "react-jsx"
  },
  "include": [
    "src/platform/**/*.ts",
    "src/platform/**/*.tsx"
  ]
}
