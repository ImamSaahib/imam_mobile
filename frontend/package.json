{
  "name": "imam-mobile-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:components",
    "check:bundle": "node scripts/check-build-budget.mjs",
    "check": "npm run test && npm run build && npm run check:bundle",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsc && node --test test/*.test.mjs",
    "test:components": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.17.0",
    "@phosphor-icons/react": "2.1.10",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "vite": "^6.0.5",
    "vitest": "4.1.12"
  }
}
